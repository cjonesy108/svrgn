# Supabase Auth
# Copy this file to .env in the project root. Restart Expo after you change it.
# Expo inlines any variable that starts with EXPO_PUBLIC_.
#
# Leave both values empty to use the on-device local session
# (src/lib/auth/local-session.ts). The app boots and the main flows work
# without a Supabase project.
#
# Set both values to use Supabase Auth (src/lib/supabase/auth.ts).
# That path never falls back to the local session.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
